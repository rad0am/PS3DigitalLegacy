{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "scripts", "vite.config.ts", "prettier.config.js", "eslint.config.js"]
}
